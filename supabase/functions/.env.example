# Set only in Supabase Edge Function Secrets; never expose to the browser.
# Do not paste the PHP/JS snippets as values. Use new, actual Sandbox credentials.
SEPAY_SANDBOX_MERCHANT_ID=
SEPAY_SANDBOX_SECRET_KEY=
# Independent key from SePay Gateway > Configuration > IPN (SECRET_KEY).
# Must exactly match X-Secret-Key; use a strong random value, 32+ characters recommended.
# Never infer it from the merchant key or use a fake/test fixture value here.
SEPAY_SANDBOX_IPN_SECRET=
